# Telegram bot token
# Local debug and test server use the test bot token.
# Production uses its own bot token.
TELEGRAM_BOT_TOKEN=

# CRM internal API endpoint
# Local debug: http://127.0.0.1:8002/api/internal/telegram/link/
# Test: https://test.schedule.kodamaclass.com/api/internal/telegram/link/
# Production: https://schedule.kodamaclass.com/api/internal/telegram/link/
CRM_TELEGRAM_LINK_API=http://127.0.0.1:8002/api/internal/telegram/link/

# Must match the secret configured in the corresponding CRM environment.
TELEGRAM_INTERNAL_API_SECRET=